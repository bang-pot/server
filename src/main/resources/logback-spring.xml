<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<springProperty
		scope="context"
		name="serviceName"
		source="spring.application.name"
		defaultValue="banglog-backend"
	/>
	<springProperty
		scope="context"
		name="environmentName"
		source="banglog.ops.environment-name"
		defaultValue="unknown"
	/>
	<springProperty
		scope="context"
		name="allLogSlackWebhookUrl"
		source="banglog.ops.slack.all-log-webhook-url"
	/>
	<springProperty
		scope="context"
		name="errorLogSlackWebhookUrl"
		source="banglog.ops.slack.error-log-webhook-url"
	/>

	<property
		name="CONSOLE_LOG_PATTERN"
		value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level service=${serviceName} env=${environmentName} requestId=%X{requestId:-na} logger=%logger{36} - %replace(%msg){'[\r\n]+', ' '}%n"
	/>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<appender name="ALL_LOG_SLACK_APPENDER" class="com.banglog.common.ops.slack.SlackWebhookAppender">
		<url>${allLogSlackWebhookUrl}</url>
		<service>${serviceName}</service>
		<environment>${environmentName}</environment>
	</appender>

	<appender name="ERROR_LOG_SLACK_APPENDER" class="com.banglog.common.ops.slack.SlackWebhookAppender">
		<url>${errorLogSlackWebhookUrl}</url>
		<service>${serviceName}</service>
		<environment>${environmentName}</environment>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
	</appender>

	<root level="${ROOT_LOG_LEVEL:-INFO}">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="ERROR_LOG_SLACK_APPENDER"/>
	</root>

	<logger name="com.banglog.common.logging.StartupLifecycleLogger" level="INFO" additivity="true">
		<appender-ref ref="ALL_LOG_SLACK_APPENDER"/>
	</logger>

	<logger name="com.banglog.common.logging.RequestTracingFilter" level="INFO" additivity="true">
		<appender-ref ref="ALL_LOG_SLACK_APPENDER"/>
	</logger>

	<logger name="com.banglog.common.logging.ServerErrorLoggingFilter" level="INFO" additivity="true">
		<appender-ref ref="ALL_LOG_SLACK_APPENDER"/>
	</logger>

	<logger name="com.banglog.auth.infrastructure.logging.AuthAuditLogger" level="INFO" additivity="true">
		<appender-ref ref="ALL_LOG_SLACK_APPENDER"/>
	</logger>
</configuration>
