<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<springProperty
		scope="context"
		name="serviceName"
		source="spring.application.name"
		defaultValue="bangpot-backend"
	/>
	<springProperty
		scope="context"
		name="environmentName"
		source="bangpot.ops.environment-name"
		defaultValue="unknown"
	/>

	<property
		name="CONSOLE_LOG_PATTERN"
		value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level service=${serviceName} env=${environmentName} requestId=%X{requestId:-na} logger=%logger{36} - %replace(%msg){'[\r\n]+', ' '}%n"
	/>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<root level="${ROOT_LOG_LEVEL:-INFO}">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
