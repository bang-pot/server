BANGPOT_DB_URL=jdbc:postgresql://localhost:5432/bangpot_local
BANGPOT_DB_USERNAME=postgres
BANGPOT_DB_PASSWORD=change-me
BANGPOT_AUTH_JWT_SECRET=replace-with-a-long-random-secret
BANGPOT_AUTH_JWT_ISSUER=bangpot
BANGPOT_AUTH_JWT_ACCESS_TOKEN_VALIDITY_SECONDS=604800
BANGPOT_AUTH_JWT_COOKIE_NAME=access_token
BANGPOT_AUTH_JWT_SECURE_COOKIE=false
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_CLIENT_AUTHENTICATION_METHOD=client_secret_post
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
BANGPOT_AUTH_FRONTEND_BASE_URL=http://localhost:3000
BANGPOT_AUTH_REQUIRED_TERMS_VERSION=2026-03-25
SERVER_PORT=8080
